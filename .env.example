# Port d'écoute du serveur FastAPI (défaut : 8000)
PORT=8000

# Clé API Google Gemini pour les moteurs de rédaction IA (optionnelle si génération locale)
GEMINI_API_KEY=AIzaSyVotreCleApiGoogleGeminiProduction2026

# Clé secrète pour la signature cryptographique des jetons JWT (RFC 7519)
JWT_SECRET=changez_cette_cle_secrete_par_une_chaine_aleatoire_tres_longue_en_production

# URL publique de l'application (pour configuration reverse-proxy Nginx / CORS)
STUDIO_PUBLIC_URL=http://localhost:8000
